rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-04), in one pipeline run from the nor9 netlist (seed 1):
// windowed construction along Y with given frozen signals and 5 s of block
// minimization per step (60 s, 2x18x10, 160 blocks), then compaction with
// repeated rounds, continued block-reduction passes and given outside
// signals until it converged (1031 s; 65 blocks plus three switches).
// Interface: operands on the Y-min face, sum driving out of the box from the
// Y-max face; cin and cout were left free. Torches are stored settled
// (`start settled;`, see docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x11x6" size [2, 11, 6] {
  start settled;
  glyph "T" = torch on y-;
  glyph "U" = torch on z-;
  glyph "V" = repeater toward y- delay 1;
  glyph "W" = torch on x+;
  glyph "X" = torch on x-;

  input "a" at [1, 0, 5] on z-;
  input "b" at [0, 0, 4] on x+;
  input "cin" at [0, 6, 5] on y-;
  output "cout" at [0, 5, 2];
  output "sum" at [0, 10, 5];

  plane yz at x=0 {
    z=5 "..WV##..r.W";
    z=4 ".r##U...#..";
    z=3 ".#VV#..WU..";
    z=2 "..##TU.r#..";
    z=1 "....r#r#...";
    z=0 "....#.#....";
  }

  plane yz at x=1 {
    z=5 ".V#.r.r.#V#";
    z=4 "##X.#T#rV#T";
    z=3 "r....rr##U.";
    z=2 "#V#r.##Vr#.";
    z=1 ".#.#...##..";
  }

  expect "cout" = ~(~(a|b)|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin));
  expect "sum" = ~(~(~(~(a|~(a|b))|~(b|~(a|b)))|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin))|~(cin|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin)));
}

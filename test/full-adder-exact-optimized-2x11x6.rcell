rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-04), in one pipeline run from the nor9 netlist (seed 1):
// windowed construction along Y with given frozen signals (14 s, 2x18x10),
// then compaction with repeated rounds, continued block-reduction passes and
// given outside signals until it converged (1190 s; 78 blocks plus three
// switches). Interface: operands on the Y-min face, sum driving out of the
// box from the Y-max face; cin and cout were left free. Torches are stored
// settled (`start settled;`, see docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x11x6" size [2, 11, 6] {
  start settled;
  glyph "P" = repeater toward y+ delay 1;
  glyph "T" = torch on y-;
  glyph "U" = torch on x+;
  glyph "V" = repeater toward y- delay 1;
  glyph "W" = torch on z-;
  glyph "X" = torch on x-;
  glyph "Y" = torch on y+;

  input "a" at [1, 0, 4] on z-;
  input "b" at [1, 0, 5] on y+;
  input "cin" at [0, 6, 5] on x+;
  output "cout" at [1, 5, 4];
  output "sum" at [1, 10, 5];

  plane yz at x=0 {
    z=5 "r.......rV#";
    z=4 "#rr#T.r.##W";
    z=3 "r##.r.#r.W#";
    z=2 "#...#V##V#.";
    z=1 ".....#T.#U.";
  }

  plane yz at x=1 {
    z=5 ".#.#rY#PY#X";
    z=4 "...r#TV#TX.";
    z=3 "#XV#..##r.r";
    z=2 "r.#r..Xr#V#";
    z=1 "#Vr#Vr.#V#.";
    z=0 ".##.##..#..";
  }

  expect "cout" = ~(~(a|b)|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin));
  expect "sum" = ~(~(~(~(a|~(a|b))|~(b|~(a|b)))|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin))|~(cin|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin)));
}

rcell 1;
cell "exact-dff-neg" size [2, 6, 4] {
  start settled;
  glyph "T" = torch on x+;
  glyph "U" = repeater toward y- delay 1;
  glyph "V" = torch on y-;
  glyph "W" = repeater toward y+ delay 1;
  glyph "X" = torch on z-;
  glyph "Y" = torch on x-;

  input "clk" at [0, 2, 0] on x+;
  input "d" at [0, 0, 1] on x+;
  output "q" at [1, 5, 1];

  plane yz at x=0 {
    z=3 "TU#Vr.";
    z=2 ".#T.#r";
    z=1 "...Tr#";
    z=0 "....#.";
  }

  plane yz at x=1 {
    z=3 "#WY...";
    z=2 "X##...";
    z=1 "#WX#WY";
    z=0 ".##V#.";
  }

}

rcell 1;
cell "boundary-dust-compare" size [4, 4, 2] {
  start settled;
  glyph "F" = torch on z-;
  glyph "N" = torch on y+;
  glyph "S" = torch on y-;
  input "a_A" at [0, 1, 1] on y+;
  output "out_A" at [0, 3, 1];
  expect "out_A" = ~a_A;
  plane yz at x=0 {
    z=1 "#.#S";
    z=0 "#...";
  }
  input "a_B" at [3, 1, 1] on y+;
  output "out_B" at [3, 3, 1];
  expect "out_B" = ~a_B;
  plane yz at x=3 {
    z=1 "r.#S";
    z=0 "#...";
  }
}

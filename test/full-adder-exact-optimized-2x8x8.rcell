rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-04), in one pipeline run from the nor9 netlist (seed 1):
// windowed construction along Y with given frozen signals and 5 s of block
// minimization per step (80 s, 2x18x10, 165 blocks), then compaction with
// repeated rounds, continued block-reduction passes, given outside signals
// and 5 s of minimization after each slice-removal repair, until it
// converged (1291 s; 60 blocks plus three switches). Interface: operands on
// the Y-min face, sum driving out of the box from the Y-max face; cin and
// cout were left free. Torches are stored settled (`start settled;`, see
// docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x8x8" size [2, 8, 8] {
  start settled;
  glyph "T" = torch on x+;
  glyph "U" = repeater toward y- delay 1;
  glyph "V" = torch on z-;
  glyph "W" = torch on y-;
  glyph "X" = torch on y+;
  glyph "Y" = repeater toward y+ delay 1;

  input "a" at [1, 0, 3] on z-;
  input "b" at [0, 0, 2] on x+;
  input "cin" at [0, 4, 7] on x+;
  output "cout" at [0, 5, 2];
  output "sum" at [1, 7, 6];

  plane yz at x=0 {
    z=7 "...r..#.";
    z=6 ".rX#..r.";
    z=5 ".#U#WU#.";
    z=4 ".r#T.#r.";
    z=3 ".#V...#.";
    z=2 ".U#..T..";
    z=1 ".#T.....";
  }

  plane yz at x=1 {
    z=7 "....#Wr.";
    z=6 "....V.#W";
    z=5 "....#...";
    z=4 ".#U#Wr#W";
    z=3 ".U#W.#.r";
    z=2 "##V#U#Y#";
    z=1 "rU#W#.#.";
    z=0 "##......";
  }

  expect "cout" = ~(~(a|b)|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin));
  expect "sum" = ~(~(~(~(a|~(a|b))|~(b|~(a|b)))|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin))|~(cin|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin)));
}

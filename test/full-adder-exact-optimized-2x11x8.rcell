rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-04): windowed construction along Y (seed 1), compaction to
// 153 blocks at 2x14x9, then two recompactions with continued block-reduction
// passes and given outside signals (2x11x8 with 86 blocks in 20 minutes, then
// 84 blocks in 14 more; 84 blocks plus three switches). Interface: operands
// on the Y-min face, sum driving out of the box from the Y-max face; cin and
// cout were left free. Torches are stored settled (`start settled;`, see
// docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x11x8" size [2, 11, 8] {
  start settled;
  glyph "P" = torch on x-;
  glyph "T" = repeater toward y- delay 1;
  glyph "U" = torch on x+;
  glyph "V" = repeater toward y+ delay 1;
  glyph "W" = torch on y+;
  glyph "X" = torch on y-;
  glyph "Y" = torch on z-;

  input "a" at [1, 0, 6] on z-;
  input "b" at [1, 0, 7] on y+;
  input "cin" at [1, 7, 1] on x-;
  output "cout" at [1, 2, 1];
  output "sum" at [1, 10, 5];

  plane yz at x=0 {
    z=7 ".#T#.#.....";
    z=6 ".Y#X#r....U";
    z=5 ".#..U#..UT#";
    z=4 "......rr.#Y";
    z=3 "......##Xr#";
    z=2 "...U.r#VW#.";
    z=1 "...r.#.#T#.";
    z=0 "...#....#..";
  }

  plane yz at x=1 {
    z=7 ".#XPrr.....";
    z=6 ".#r.##X...#";
    z=5 "#r#T#.rT#.P";
    z=4 ".#T#VW##Y..";
    z=3 "..#r#..r#Tr";
    z=2 "...#...#W##";
    z=1 "..W#rP...P.";
    z=0 "....#......";
  }

  expect "cout" = ~(~(a|b)|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin));
  expect "sum" = ~(~(~(~(a|~(a|b))|~(b|~(a|b)))|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin))|~(cin|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin)));
}

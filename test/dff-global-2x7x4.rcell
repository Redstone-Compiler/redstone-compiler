rcell 1;
cell "exact-dff-neg" size [2, 7, 4] {
  start settled;
  glyph "P" = torch on x-;
  glyph "T" = repeater toward y- delay 1;
  glyph "U" = torch on y-;
  glyph "V" = repeater toward y+ delay 1;
  glyph "W" = torch on x+;
  glyph "X" = torch on z-;
  glyph "Y" = torch on y+;

  input "clk" at [0, 3, 3] on y+;
  input "d" at [0, 6, 1] on x+;
  output "q" at [1, 1, 3];

  plane yz at x=0 {
    z=3 ".rT.#VW";
    z=2 "r##r.#.";
    z=1 "#T##U..";
    z=0 "#####.#";
  }

  plane yz at x=1 {
    z=3 "#Y#VPT#";
    z=2 "..X#.#X";
    z=1 "rr#rrT#";
    z=0 "##.####";
  }

}

rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-03, seed 1): windowed construction along Y (27 s, no
// simulator rejections), slice/layer compaction, then block reduction with
// each window optimized in one solve (153 blocks plus three switches).
// Interface: operands on the Y-min face, sum driving out of the box from the
// Y-max face; cin and cout were left free. Torches are stored settled
// (`start settled;`, see docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x14x9" size [2, 14, 9] {
  start settled;
  glyph "P" = torch on x-;
  glyph "Q" = repeater toward y+ delay 1;
  glyph "T" = torch on y-;
  glyph "U" = repeater toward y- delay 1;
  glyph "V" = torch on z-;
  glyph "W" = torch on x+;
  glyph "X" = torch on y+;
  glyph "Y" = repeater toward x+ delay 1;

  input "a" at [1, 0, 7] on z-;
  input "b" at [1, 0, 8] on y+;
  input "cin" at [1, 8, 2] on x-;
  output "cout" at [1, 13, 3];
  output "sum" at [0, 13, 8];

  plane yz at x=0 {
    z=8 ".#U#r#T.rr#r#Y";
    z=7 ".V#T#...##.#Y#";
    z=6 ".#......#V.X#U";
    z=5 ".......rU#..X#";
    z=4 ".....#r##TWr#T";
    z=3 "...W..#.X#X#U#";
    z=2 "...rU#r.#T#r#V";
    z=1 "...##.#TUUr#U#";
    z=0 "........######";
  }

  plane yz at x=1 {
    z=8 ".#T..#r..#PUr#";
    z=7 ".#r.Vr#TQr.##.";
    z=6 "#r#U##.r####rU";
    z=5 ".#U#Q#.#U#r###";
    z=4 "..#r#P.r#T##r.";
    z=3 "...#...#.#r.#P";
    z=2 ".......V..#TX#";
    z=1 "....#..#r#UU#T";
    z=0 "........#.####";
  }

  expect "cout" = a&b|a&cin|b&cin;
  expect "sum" = a^b^cin;
}

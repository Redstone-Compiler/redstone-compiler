rcell 1;

// Height-bounded full adder: two low XNOR cones, placed side by side.
// Compiler coordinates: z is height; each row spans y=0..16.
// P/Q flow +Y/-Y; U is a top torch, W/V attach toward -X/+X.
// Each input has one physical switch. Carry uses n1 and n5 directly.
cell "full-adder-2x17x10" size [2, 17, 10] {
  glyph "U" = torch on z-;
  glyph "W" = torch on x-;
  glyph "V" = torch on x+;
  glyph "P" = repeater toward y- delay 1;
  glyph "Q" = repeater toward y+ delay 1;
  auto-support dust repeater;
  input "a" at [0, 0, 1] on x+;
  input "b" at [0, 6, 1] on x+;
  input "cin" at [0, 16, 4] on x+;
  probe "n1" at [1, 3, 1];
  probe "n2" at [1, 0, 2];
  probe "n3" at [1, 6, 2];
  probe "xnor" at [1, 3, 5];
  probe "second_input" at [1, 8, 4];
  probe "n5" at [1, 13, 4];
  probe "n6" at [1, 10, 5];
  probe "n7" at [1, 16, 5];
  probe "carry_n5" at [0, 13, 7];
  output "sum" at [1, 13, 8];
  probe "carry_n1" at [0, 3, 8];
  output "cout" at [1, 11, 9];

  // Rear plane: input joins, isolated XNOR input branch, n1 relay and carry join.
  plane yz at x=0 {
  z=9 ".....rrrrrP#Qr...";
  z=8 "...Ur........#...";
  z=7 "...#.........U...";
  z=6 "...U.........#...";
  z=5 "...#...r.....V...";
  z=4 "...U....rrPrP#Qr.";
  z=3 "...#.............";
  z=2 "...V.............";
  z=1 ".rP#Qr...........";
  }

  // Front plane: two XNOR cones and the sum connection between them.
  plane yz at x=1 {
  z=9 "...........W.....";
  z=8 ".............U...";
  z=7 "..........rrP#Qrr";
  z=6 "...#rrrr..#.....#";
  z=5 "...U......U..#..U";
  z=4 "rrP#Qrr.rP#QrWrP#";
  z=3 "#.....#..........";
  z=2 "U..#..U..........";
  z=1 "#QrWrP#..........";
  }

  expect "n1" = ~(a|b);
  expect "n2" = ~(a|~(a|b));
  expect "n3" = ~(b|~(a|b));
  expect "xnor" = ~(a^b);
  expect "second_input" = ~(a^b);
  expect "n5" = ~((~(a^b))|cin);
  expect "n6" = ~((~(a^b))|~((~(a^b))|cin));
  expect "n7" = ~(cin|~((~(a^b))|cin));
  expect "carry_n5" = ~((~(a^b))|cin);
  expect "sum" = a^b^cin;
  expect "carry_n1" = ~(a|b);
  expect "cout" = a&b|a&cin|b&cin;
}

rcell 1;

// Generated by the exact (SAT) local placer, not drawn by hand: windowed
// construction along Y, slice/layer compaction with exact window repair,
// then sliding-window block minimization (docs/exact_local_placer.md).
// Interface: both operands on the Y-min face, sum driving out of the Y-max
// face; cin and cout were left free.
cell "full-adder-exact-2x13x7" size [2, 13, 7] {
  glyph "P" = torch on x-;
  glyph "T" = torch on x+;
  glyph "U" = repeater toward y- delay 1;
  glyph "V" = torch on y-;
  glyph "W" = torch on z-;
  glyph "X" = repeater toward y+ delay 1;
  glyph "Y" = repeater toward x+ delay 1;

  input "b" at [0, 0, 0] on x+;
  input "a" at [1, 0, 2] on y+;
  input "cin" at [0, 6, 6] on y-;
  output "cout" at [1, 11, 3];
  output "sum" at [1, 12, 6];

  plane yz at x=0 {
    z=6 ".#UU##...rTU#";
    z=5 ".W##W.TU##W#W";
    z=4 ".#W.#..#rr#U#";
    z=3 ".W#XWT..##U#Y";
    z=2 ".#V##r#V#r#W#";
    z=1 ".T...#.rr#U#T";
    z=0 ".......##.#.#";
  }

  plane yz at x=1 {
    z=6 "..#rP#rU#U##P";
    z=5 "..r#Vr##W##.#";
    z=4 "..#..#Ur#Ur.P";
    z=3 "..#VU###.##P#";
    z=2 ".#V.#U#UUr.#W";
    z=1 ".#U#V#.####r#";
    z=0 "#V#.....####.";
  }

  expect "cout" = a&b|a&cin|b&cin;
  expect "sum" = a^b^cin;
}

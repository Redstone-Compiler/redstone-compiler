rcell 1;

// Generated by the exact (SAT) local placer from the rsdsl model, not drawn
// by hand (2026-10-04): windowed construction along Y (seed 1), then
// compaction by slice removal and block reduction, run three times in a row
// (153 blocks at 2x14x9, then 106 and 84 blocks at 2x12x8; 84 blocks plus
// three switches). The later runs are what `CompactionConfig::repeat_rounds`
// now does in one call. Interface: operands on the Y-min face, sum driving
// out of the box from the Y-max face; cin and cout were left free. Torches
// are stored settled (`start settled;`, see docs/physical_cell_lab.md).
cell "full-adder-exact-optimized-2x12x8" size [2, 12, 8] {
  start settled;
  glyph "T" = torch on y+;
  glyph "U" = repeater toward y+ delay 1;
  glyph "V" = torch on x+;
  glyph "W" = repeater toward y- delay 1;
  glyph "X" = torch on y-;
  glyph "Y" = torch on z-;

  input "a" at [1, 0, 6] on z-;
  input "b" at [1, 0, 7] on y+;
  input "cin" at [1, 7, 1] on x-;
  output "cout" at [0, 7, 2];
  output "sum" at [0, 11, 6];

  plane yz at x=0 {
    z=7 ".#W#X#......";
    z=6 ".Y#X#r...r.V";
    z=5 ".#..V#...#..";
    z=4 "......rW#X.r";
    z=3 "....V.##X..#";
    z=2 "....rW#X...Y";
    z=1 "....##T#UVW#";
    z=0 "........#.#.";
  }

  plane yz at x=1 {
    z=7 ".#X.rr......";
    z=6 ".#r.##X..#W#";
    z=5 "#r#W#.r...#Y";
    z=4 ".#W#UT#r...#";
    z=3 "..#r#..#Wr..";
    z=2 "...#....##X.";
    z=1 "........r#r.";
    z=0 "........#.#.";
  }

  expect "cout" = ~(~(a|b)|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin));
  expect "sum" = ~(~(~(~(a|~(a|b))|~(b|~(a|b)))|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin))|~(cin|~(~(~(a|~(a|b))|~(b|~(a|b)))|cin)));
}
